---
import { asset, projectUrl } from "../data/projects";
import { projectsForLocale } from "../data/projects-en";
interface Props { lang?: "es" | "en" }
const lang = Astro.props.lang ?? "es";
const en = lang === "en";
const t = (es: string, english: string) => en ? english : es;
const picks = ["vigia","cpaul","pubg-map","repo-setup"];
const projects = picks.map(id => projectsForLocale(lang).find(project => project.id===id)).filter(project=>project!==undefined);
const projectLink = (id: string) => projectUrl(id,lang);
const portrait = (id:string) => id==="repo-setup" ? "" : asset("media/"+(id==="vigia"?"vigia-modules.webp":id==="cpaul"?"atelier-colors.webp":"tactical-map.webp"));
const story = [
 {number:"01",title:t("Definir el problema","Define the problem"),body:t("Entender el contexto, las personas y el objetivo antes de escribir código.","Understand the context, the people, and the goal before writing code.")},
 {number:"02",title:t("Diseñar el sistema","Design the system"),body:t("Conectar interfaz, reglas de negocio, datos y experiencia de uso.","Connect interfaces, business rules, data, and user experience.")},
 {number:"03",title:t("Construir y probar","Build and test"),body:t("Implementar módulos, comprobar flujos y validar la solución.","Implement modules, verify flows, and validate the solution.")},
 {number:"04",title:t("Desplegar y mejorar","Deploy and improve"),body:t("Publicar con controles, revisar rendimiento y mantener el producto.","Release with checks, review performance, and maintain the product.")}
];
---
<div class="edition-experiences" data-edition-experiences data-projects={JSON.stringify(projects.map(p=>({id:p.id,title:p.title,summary:p.summary,label:p.label,href:projectLink(p.id),image:portrait(p.id)})))} data-story-steps={JSON.stringify(story)}>
  <section class="edition-scene edition-os shell" data-edition-scene="skull-os" aria-labelledby="os-heading">
    <div class="edition-overline">08 / SKULL OS · {t("ESCRITORIO INTERACTIVO","INTERACTIVE DESKTOP")}</div>
    <div class="os-desktop" data-os>
      <div class="os-topbar"><span>SKULL // OS</span><span>{t("Espacio de trabajo","Workspace")}</span><span class="os-clock">● CONNECTED</span></div>
      <div class="os-surface">
        <div class="os-intro">
          <p class="mono">/home/skull/portfolio</p>
          <h2 id="os-heading">{t("Mi trabajo,","My work,")}<br/><span>{t("tu escritorio.","your desktop.")}</span></h2>
          <p>{t("Abrí los proyectos como aplicaciones y explorá su ficha sin salir del escritorio.","Open projects as apps and explore their case studies without leaving the desktop.")}</p>
        </div>
        <div class="os-icons" role="group" aria-label={t("Aplicaciones del escritorio","Desktop applications")}>
          {projects.map((p,i)=><button data-os-open={p.id} type="button" aria-pressed={i===0?"true":"false"}>
            <span class="os-icon" aria-hidden="true">{["▣","◇","⌖","⌘"][i]}</span>
            <span>{p.title}</span>
          </button>)}
        </div>
        <div class="os-window" data-os-window>
          <div class="os-window-bar"><div class="os-dots" aria-hidden="true"><span></span><span></span><span></span></div><span data-os-window-title>{projects[0]?.title}</span><span class="mono">SKULL.APP</span></div>
          <div class="os-window-content">
            <img data-os-image src={portrait("vigia")} width="900" height="550" loading="lazy" alt={t("Captura del proyecto seleccionado","Screenshot of the selected project")} /><div class="os-image-placeholder" data-os-placeholder hidden aria-hidden="true">REPO / SETUP KIT</div>
            <div><span class="mono" data-os-type>{projects[0]?.label}</span><h3 data-os-name>{projects[0]?.title}</h3><p data-os-summary>{projects[0]?.summary}</p>
              <a data-os-link href={projectLink("vigia")}>{t("Abrir ficha completa","Open case study")} ↗</a>
            </div>
          </div>
        </div>
      </div>
      <div class="os-dock"><span>SKULL</span><span>●</span><span>{t("Proyectos · Escritorio","Projects · Desktop")}</span><span>↗</span></div>
    </div>
  </section>
  <section class="edition-scene edition-xray shell" data-edition-scene="xray" aria-labelledby="xray-heading">
    <div class="edition-overline">09 / X-RAY 3D · {t("ARQUITECTURA EN CAPAS","LAYERED ARCHITECTURE")}</div>
    <div class="xray-shell" data-xray>
      <div class="xray-heading"><span class="mono">SKULL / SYSTEM.EXPLODED</span><h2 id="xray-heading">{t("Desarmá el sistema.","Dissect the system.")}</h2><p>{t("Seleccioná una capa para ver cómo las piezas de software trabajan juntas. Modelo conceptual, no datos en vivo.","Select a layer to see how software components work together. Conceptual model, not live production data.")}</p></div>
      <div class="xray-model" aria-hidden="true">
        <div class="xray-plate xray-plate-1"><span>UI / 01</span><div class="xray-glyph">▦ ▤ ▣</div></div>
        <div class="xray-plate xray-plate-2"><span>API / 02</span><div class="xray-glyph">{"{ }"}</div></div>
        <div class="xray-plate xray-plate-3"><span>DATA / 03</span><div class="xray-glyph">⛁</div></div>
        <div class="xray-plate xray-plate-4"><span>OPS / 04</span><div class="xray-glyph">⌘</div></div>
      </div>
      <div class="xray-controls">
        <div class="xray-layers" role="group" aria-label={t("Capas del sistema","System layers")}>
          {[
            [t("Interfaz","Interface"),t("Pantallas, componentes y accesibilidad.","Screens, components and accessibility.")],
            ["API",t("Lógica, permisos y contratos.","Business logic, permissions and contracts.")],
            [t("Datos","Data"),t("Persistencia, consultas y validación.","Persistence, queries and validation.")],
            [t("Operaciones","Operations"),t("Despliegue, pruebas y monitoreo.","Deployment, tests and monitoring.")],
          ].map((item,i)=><button type="button" data-xray-pick={i} aria-pressed={i===0?"true":"false"}><span class="mono">0{i+1}</span><strong>{item[0]}</strong><span aria-hidden="true">↗</span></button>)}
        </div>
        <div class="xray-readout" aria-live="polite"><span class="mono">LAYER / <span data-xray-count>01</span></span><h3 data-xray-title>{t("Interfaz","Interface")}</h3><p data-xray-description>{t("Pantallas, componentes y accesibilidad.","Screens, components and accessibility.")}</p></div>
      </div>
    </div>
  </section>
  <section class="edition-scene edition-museum shell" data-edition-scene="museum" aria-labelledby="museum-heading">
    <div class="edition-overline">10 / DIGITAL MUSEUM · {t("EXPOSICIÓN DE SOFTWARE","SOFTWARE EXHIBITION")}</div>
    <div class="museum-hall" data-museum>
      <div class="museum-masthead"><span class="mono">SKULL / COLLECTION 2026</span><h2 id="museum-heading">{t("Galería de sistemas.","Gallery of systems.")}</h2><p>{t("Los proyectos son piezas para explorar. Cambiá la obra en exposición.","Projects become exhibits. Change the work on display.")}</p></div>
      <div class="museum-gallery">
        <div class="museum-frame"><img data-museum-image src={portrait("vigia")} loading="lazy" decoding="async" alt={t("Captura de Vigía en exposición","Vigía screenshot on display")} width="900" height="550" /><div class="museum-placeholder" data-museum-placeholder hidden aria-hidden="true">REPO / SETUP KIT</div><span class="museum-frame-corner">SK / 01</span></div>
        <div class="museum-placard"><span class="mono" data-museum-index>01 / 04</span><h3 data-museum-title>{projects[0]?.title}</h3><p data-museum-desc>{projects[0]?.summary}</p><a data-museum-link href={projectLink("vigia")}>{t("Estudiar la obra","Study the project")} ↗</a>
          <div class="museum-navigation"><button type="button" data-museum-previous aria-label={t("Obra anterior","Previous exhibit")}>←</button><button type="button" data-museum-next aria-label={t("Obra siguiente","Next exhibit")}>→</button></div>
        </div>
      </div>
    </div>
  </section>
  <section class="edition-scene edition-terminal shell" data-edition-scene="terminal" aria-labelledby="terminal-heading">
    <div class="edition-overline">11 / TERMINAL HACKER PRO · {t("COMANDOS INTERACTIVOS","INTERACTIVE COMMANDS")}</div>
    <div class="terminal-shell" data-terminal>
      <div class="terminal-toolbar"><span aria-hidden="true">● ● ●</span><span>skull@portfolio:~</span><span>UTF-8 / {lang.toUpperCase()}</span></div>
      <div class="terminal-inner"><h2 id="terminal-heading">~/skull<span class="terminal-cursor">_</span></h2><p>{t("Explorá el portafolio escribiendo comandos reales. No ejecuta código del sistema.","Explore the portfolio using real commands. It does not execute operating-system code.")}</p>
        <div class="terminal-history" data-terminal-history role="log" aria-live="polite" aria-relevant="additions text">
          <p><span class="terminal-prompt">skull@portfolio $</span> help</p>
          <p>{t("Comandos: help · projects · skills · contact · about · clear","Commands: help · projects · skills · contact · about · clear")}</p>
        </div>
        <form class="terminal-form" data-terminal-form><label for="skull-cmd">skull@portfolio $</label><input id="skull-cmd" data-terminal-input type="text" spellcheck="false" autocomplete="off" maxlength="50" placeholder={t("Escribí help","Type help")} aria-label={t("Comando de terminal","Terminal command")} /><button type="submit">{t("Ejecutar ↵","Run ↵")}</button></form>
        <div class="terminal-shortcuts" role="group" aria-label={t("Comandos rápidos","Quick commands")}>{["help","projects","skills","contact"].map(cmd=><button type="button" data-terminal-quick={cmd}>{cmd}</button>)}</div>
      </div>
    </div>
  </section>
  <section class="edition-scene edition-canvas shell" data-edition-scene="canvas" aria-labelledby="canvas-heading">
    <div class="edition-overline">12 / INFINITE CANVAS · {t("MAPA DE PROYECTOS","PROJECT MAP")}</div>
    <div class="canvas-shell" data-canvas>
      <div class="canvas-heading"><div><span class="mono">SKULL / SPACE.MAP</span><h2 id="canvas-heading">{t("Mapa abierto.","Open canvas.")}</h2></div><p>{t("Desplazá el mapa, acercate y elegí un proyecto. Los controles también funcionan sin gestos táctiles complejos.","Pan, zoom and select projects. The controls also work without complex touch gestures.")}</p></div>
      <div class="canvas-viewport" data-canvas-viewport tabindex="0" aria-label={t("Mapa de proyectos. Usá flechas para moverte y más o menos para zoom.","Project map. Use arrow keys to pan and plus or minus to zoom.")}>
        <div class="canvas-space" data-canvas-space>
          <svg viewBox="0 0 900 600" aria-hidden="true"><path d="M170 160 530 110 720 340 380 470 170 160M530 110 380 470"/></svg>
          {projects.map((p,i)=><a class:list={["canvas-node","canvas-node-"+i]} href={projectLink(p.id)}><span class="mono">0{i+1} / {p.label}</span><strong>{p.title}</strong><span>{t("Abrir proyecto","Open project")} ↗</span></a>)}
        </div>
        <div class="canvas-zoom mono" aria-live="polite" data-canvas-zoom>100%</div>
      </div>
      <div class="canvas-tools"><div role="group" aria-label={t("Desplazar mapa","Pan map")}><button data-pan="left" aria-label={t("Mover a la izquierda","Pan left")}>←</button><button data-pan="right" aria-label={t("Mover a la derecha","Pan right")}>→</button><button data-pan="up" aria-label={t("Mover arriba","Pan up")}>↑</button><button data-pan="down" aria-label={t("Mover abajo","Pan down")}>↓</button></div><div role="group" aria-label={t("Zoom del mapa","Map zoom")}><button data-zoom="out" aria-label={t("Alejar","Zoom out")}>−</button><button data-zoom="reset" aria-label={t("Restablecer vista","Reset view")}>⌂</button><button data-zoom="in" aria-label={t("Acercar","Zoom in")}>+</button></div></div>
    </div>
  </section>
  <section class="edition-scene edition-brutal shell" data-edition-scene="brutalist" aria-labelledby="brutal-heading">
    <div class="edition-overline">13 / NEO-BRUTALIST LAB · {t("SIN ORNAMENTOS","WITHOUT PRETENSE")}</div>
    <div class="brutal-panel" data-brutal>
      <div class="brutal-head"><span>SKULL / LAB №13</span><span>BUILT DIFFERENT ↗</span></div>
      <h2 id="brutal-heading">{t("IDEAS.","IDEAS.")}<span>{t("CÓDIGO.","CODE.")}</span><em>{t("RESULTADOS.","RESULTS.")}</em></h2>
      <p>{t("Un diseño directo, con bloques, contrastes y una demostración de cómo trabajo.","An unapologetically direct layout, bold blocks, and an interactive look at my process.")}</p>
      <div class="brutal-steps" role="group" aria-label={t("Etapas de trabajo","Work phases")}>
        {story.map((step,i)=><button type="button" data-brutal-pick={i} aria-pressed={i===0?"true":"false"}><span>{step.number}</span><strong>{step.title}</strong><span aria-hidden="true">↗</span></button>)}
      </div>
      <div class="brutal-result" aria-live="polite"><span data-brutal-count>01 / 04</span><strong data-brutal-title>{story[0].title}</strong><p data-brutal-description>{story[0].body}</p></div>
    </div>
  </section>
  <section class="edition-scene edition-story shell" data-edition-scene="story" aria-labelledby="story-heading">
    <div class="edition-overline">14 / STORY MODE · {t("RECORRIDO NARRATIVO","NARRATIVE JOURNEY")}</div>
    <div class="story-shell" data-story>
      <div class="story-sidebar"><span class="mono">SKULL / CHAPTERS</span><h2 id="story-heading">{t("Del concepto","From concept")}<br/>{t("a la pantalla.","to screen.")}</h2><p>{t("Cuatro capítulos sobre el proceso de construir software.","Four chapters on the process of building software.")}</p>
        <ol class="story-chapters">{story.map((step,i)=><li><button type="button" data-story-pick={i} aria-current={i===0?"step":undefined}><span>{step.number}</span>{step.title}</button></li>)}</ol>
      </div>
      <div class="story-content"><div class="story-topline"><span class="mono">CHAPTER <span data-story-index>01</span> / 04</span><span class="mono">SKULL / METHOD</span></div><div class="story-illustration" aria-hidden="true"><span class="story-orbit"></span><span class="story-square"></span><span class="story-center">SK</span></div><h3 data-story-title>{story[0].title}</h3><p data-story-description>{story[0].body}</p><div class="story-bottom"><span class="mono">{t("SIN SCROLL OBLIGATORIO","NO FORCED SCROLL")}</span><button data-story-next type="button">{t("Siguiente capítulo","Next chapter")} ↗</button></div></div>
    </div>
  </section>
</div>
<script>import "../scripts/edition-experiences";</script>
