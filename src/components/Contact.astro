---
import { profile } from "../data/profile";
interface Props { lang?: "es" | "en" }
const lang = Astro.props.lang ?? "es";
const tr = (es: string, english: string) => lang === "en" ? english : es;
---

<section
  id="contacto"
  class="contact-section shell"
  aria-labelledby="contact-title"
>
  <p class="eyebrow" data-reveal>
    {tr("04 / SIGUIENTE SEÑAL","06 / GET IN TOUCH")}
  </p>
  <div class="contact-heading">
    <h2 id="contact-title" data-reveal>
      {tr("¿Qué tenés","What's on")}
      <br />
      <span class="muted">{tr("en mente?","your mind?")}</span>
    </h2>
    <a
      class="contact-arrow"
      href={`mailto:${profile.email}`}
      aria-label={`${lang === "en" ? "Email me at" : "Escribime a"} ${profile.email}`}
    >
      ↗
    </a>
  </div>
  <div class="contact-bottom">
    <p>
      {tr("Una aplicación, una integración o una herramienta","An app, an integration or a tool")}
      <br />
      {tr("que simplifique el trabajo. Contame la idea.","that makes work easier. Tell me about your idea.")}
    </p>
    <a class="email-link" href={`mailto:${profile.email}`}>
      {profile.email} <span aria-hidden="true">↗</span>
    </a>
  </div>
  <details class="inquiry-details" hidden>
    <summary>
      {tr("Prefiero preparar una consulta","I prefer to prepare an inquiry")} <span aria-hidden="true">+</span>
    </summary>
    <form id="inquiry-form" novalidate>
      <div class="form-grid">
        <label>
          {tr("Tu nombre","Your name")}
          <input name="name" autocomplete="name" required maxlength="100" />
        </label>
        <label>
          {tr("Tu email","Your email")}
          <input
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="200"
          />
        </label>
        <label>
          <span id="inquiry-service-label">{tr("¿Qué necesitás?","What do you need?")}</span>
          <select
            name="service"
            required
            aria-labelledby="inquiry-service-label"
          >
            <option value="">{tr("Elegí una opción","Choose an option")}</option>
            <option>{tr("Aplicación web","Web application")}</option>
            <option>{tr("Android o escritorio","Android or desktop")}</option>
            <option>{tr("Diseño e interacción","Design and interaction")}</option>
            <option>{tr("Linux y automatización","Linux and automation")}</option>
            <option>{tr("Otro proyecto","Other project")}</option>
          </select>
        </label>
        <label>
          {tr("Proyecto de referencia","Reference project")}
          <input name="reference" maxlength="120" />
        </label>
        <label class="full-field">
          {tr("Contame tu idea","Tell me about your idea")}
          <textarea
            name="idea"
            rows="4"
            required
            minlength="15"
            maxlength="5000"
          ></textarea>
        </label>
      </div>
      <p id="form-error" role="alert" hidden></p>
      <button class="solid-button" type="submit">
        {tr("Preparar consulta","Prepare inquiry")} <span aria-hidden="true">↗</span>
      </button>
      <p class="form-note">
        {tr("Vas a poder revisar el mensaje y abrirlo en tu correo para enviarlo.","Review the message and open it in your email app before sending it.")}
      </p>
      <div id="inquiry-result" hidden>
        <label>
          {tr("Mensaje preparado","Prepared message")}
          <textarea id="inquiry-message" rows="8" readonly></textarea>
        </label>
        <div class="form-actions">
          <a id="email-draft" class="solid-button">
            {tr("Abrir en mi correo","Open in email")} ↗
          </a>
          <button id="copy-inquiry" class="outline-button" type="button">
            {tr("Copiar mensaje","Copy message")}
          </button>
          <button id="download-inquiry" class="outline-button" type="button">
            {tr("Descargar texto","Download text")}
          </button>
        </div>
        <p id="copy-status" role="status"></p>
      </div>
    </form>
  </details>
</section>
