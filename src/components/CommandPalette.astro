---
import { projects, projectUrl, asset } from "../data/projects";
import { projectsForLocale } from "../data/projects-en";
interface Props { lang?: "es" | "en" }
const lang = Astro.props.lang ?? "es";
const en = lang === "en";
const entries = projectsForLocale(lang).map(p => ({ title:p.title, subtitle:p.label, keywords:[p.summary,...p.stack,p.status].join(" "), href:projectUrl(p.id,lang), group:en?"Projects":"Proyectos" }));
const navigation = [
  {title:en?"Home":"Inicio",subtitle:en?"Go to homepage":"Ir a la portada",href:asset(en?"en/":""),group:en?"Navigation":"Navegación"},
  {title:en?"Project archive":"Archivo de proyectos",subtitle:en?"Browse 21 projects":"Explorar 21 proyectos",href:asset(en?"en/projects/":"proyectos/"),group:en?"Navigation":"Navegación"},
  {title:en?"Contact":"Contacto",subtitle:en?"Send an inquiry":"Enviar una consulta",href:asset(en?"en/#contacto":"#contacto"),group:en?"Navigation":"Navegación"},
  ...["editorial","casebook","systems","atelier","chromatic","pocket","studio","skull-os","xray","museum","terminal","canvas","brutalist","story"].map(id=>({title:id.toUpperCase(),subtitle:en?"Switch design edition":"Cambiar edición visual",href:asset(en?"en/":"")+"?design="+id,group:en?"Editions":"Ediciones"}))
];
const items = [...navigation,...entries];
---
<button type="button" class="command-trigger" data-command-trigger aria-haspopup="dialog" aria-controls="skull-command" aria-label={en?"Search projects and commands":"Buscar proyectos y comandos"}>
  <span aria-hidden="true">⌕</span><span>{en?"Search":"Buscar"}</span><kbd>⌘ K</kbd>
</button>
<dialog class="command-dialog" id="skull-command" aria-label={en?"Search projects, navigation and editions":"Buscar proyectos, navegación y ediciones"} data-command-dialog data-command-items={JSON.stringify(items)}>
  <div class="command-shell">
    <div class="command-searchbar"><span aria-hidden="true">⌕</span><label class="sr-only" for="command-query">{en?"Search":"Buscar"}</label><input id="command-query" data-command-input type="search" autocomplete="off" spellcheck="false" placeholder={en?"Search projects, technologies, editions…":"Buscar proyectos, tecnologías, ediciones…"} /><button type="button" data-command-close aria-label={en?"Close search":"Cerrar búsqueda"}>ESC</button></div>
    <div class="command-shortcuts">
      <button type="button" data-command-editions aria-label={en?"Browse the 14 visual editions":"Explorar las 14 ediciones visuales"}>
        <span aria-hidden="true">✦</span>
        {en?"14 visual editions":"14 estilos visuales"}
        <span aria-hidden="true">↗</span>
      </button>
      <span>{en?"Projects, technologies and design styles in one place.":"Proyectos, tecnologías y estilos en un solo lugar."}</span>
    </div>
    <p class="command-count mono" data-command-count aria-live="polite"></p>
    <div class="command-results" data-command-results role="listbox" aria-label={en?"Search results":"Resultados de búsqueda"}></div>
    <div class="command-footer mono"><span>↑ ↓ {en?"Navigate":"Navegar"}</span><span>↵ {en?"Open":"Abrir"}</span><span>ESC {en?"Close":"Cerrar"}</span></div>
  </div>
</dialog>
<script>
  import "../scripts/command-palette.ts";
</script>
