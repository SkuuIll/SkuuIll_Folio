---
import { projectUrl, asset } from "../data/projects";
import { projectsForLocale } from "../data/projects-en";
interface Props { lang?: "es" | "en" }
const lang = Astro.props.lang ?? "es";
const tr = (es: string, english: string) => lang === "en" ? english : es;
const projects = projectsForLocale(lang);

const featuredIds = ["vigia", "cpaul", "pubg-map", "mi-taller", "repo-setup", "fluxnet"];
const featured = featuredIds.map((id) => projects.find((item) => item.id === id)).filter((item) => item !== undefined);
const capabilities = [
  {
    index: "01",
    label: tr("Producto & frontend","Product & frontend"),
    title: tr("Interfaces que se pueden usar.","Interfaces people can use."),
    description: tr("Webs, paneles, PWA y flujos comerciales diseñados para personas reales.","Websites, dashboards, PWAs, and commerce flows for real users."),
    tools: "React · Next.js · Vue · TypeScript · CSS",
  },
  {
    index: "02",
    label: tr("Backend & arquitectura","Backend & architecture"),
    title: tr("La lógica detrás de la pantalla.","The logic behind the screen."),
    description: tr("APIs, procesos de negocio, autenticación e integración de datos.","APIs, business logic, authentication, and data integration."),
    tools: "Python · Node.js · NestJS · SQL · Redis",
  },
  {
    index: "03",
    label: tr("Mobile & sistemas","Mobile & systems"),
    title: tr("Software donde se necesita.","Software where it is needed."),
    description: tr("Aplicaciones Android, herramientas de escritorio e integración con dispositivos.","Android apps, desktop tools, and device integration."),
    tools: "Kotlin · Flutter · Java · Linux",
  },
  {
    index: "04",
    label: tr("Infraestructura & automatización","Infrastructure & automation"),
    title: tr("Del código al entorno real.","From source to production."),
    description: tr("Despliegues, mantenimiento de VPS, flujos CI/CD y automatización de tareas.","Deployments, VPS maintenance, CI/CD, and automation."),
    tools: "Docker · GitHub Actions · Shell · Python",
  },
];
---
<section class="portfolio-work shell" id="trabajo" aria-labelledby="portfolio-work-title">
  <div class="portfolio-work-heading">
    <div>
      <p class="eyebrow">{tr("02 / PROYECTOS SELECCIONADOS","02 / SELECTED PROJECTS")}</p>
      <h2 id="portfolio-work-title">{tr("No es un concepto.","Not just a concept.")}<br/><span>{tr("Es software.","It's working software.")}</span></h2>
    </div>
    <p>{tr("Una selección de productos y herramientas que desarrollé: desde operaciones hoteleras hasta experiencias 3D, mapas, aplicaciones y automatización.","A selection of software and tools I have built, from hotel systems to 3D experiences, maps, applications and automation.")}</p>
  </div>

  <div class="portfolio-edition-context" aria-label={tr("Presentación visual actual","Current presentation style")}>
    <span class="mono">{tr("EDICIÓN / PRESENTACIÓN","EDITION / PRESENTATION")}</span>
    <strong data-work-edition-name>{tr("Editorial / Identidad","Editorial / Identity")}</strong>
    <span data-work-edition-note>{tr("Tipografía protagonista, composición asimétrica y un lenguaje visual sobrio.","Oversized type, asymmetrical composition and a restrained visual language.")}</span>
  </div>
  <div class="portfolio-work-grid">
    {featured.map((project, index) => (
      <article class:list={["portfolio-work-card", index < 2 && "portfolio-work-card--feature"]}>
        <a class="portfolio-work-link" href={projectUrl(project.id, lang)} aria-label={`${lang === "en" ? "View case study:" : "Ver el caso de"} ${project.title}`}>
          <div class:list={["portfolio-work-media", `portfolio-work-media--${project.tone}`]}>
            {project.image ? (
              <img
                src={asset(`media/${project.image}`)}
                alt={project.alt || `Visualización de ${project.title}`}
                loading="lazy"
                decoding="async"
                width="900"
                height="550"
              />
            ) : (
              <div class="portfolio-work-art" aria-hidden="true">
                <span class="portfolio-work-rings"></span>
                <span class="portfolio-work-art-label">SK / {String(index + 1).padStart(2, "0")}</span>
                <span class="portfolio-work-art-mark">↗</span>
              </div>
            )}
            <span class="portfolio-work-media-id">{tr("PROYECTO", "PROJECT")} / {String(index + 1).padStart(2, "0")}</span>
            <span class="portfolio-work-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="portfolio-work-body">
            <div class="portfolio-work-meta"><span>{project.label}</span><span>{project.status}</span></div>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <div class="portfolio-work-tech" aria-label={tr("Tecnologías","Technologies")}>
              {project.stack.slice(0, 4).map((tech) => <span>{tech}</span>)}
            </div>
          </div>
        </a>
      </article>
    ))}
  </div>
  <a class="portfolio-archive-link" href={asset(lang === "en" ? "en/projects/" : "proyectos/")}>
    <span>{tr("Explorá el archivo de proyectos completo","Explore the full project archive")}</span>
    <span aria-hidden="true">↗</span>
  </a>
</section>

<section class="portfolio-capabilities shell" id="capacidades" aria-labelledby="capabilities-title">
  <div class="portfolio-capabilities-heading">
    <p class="eyebrow">{tr("03 / QUÉ HAGO","03 / WHAT I DO")}</p>
    <h2 id="capabilities-title">{tr("Una mirada integral.","The big picture.")}<br/><span>{tr("Del diseño al despliegue.","From design to deployment.")}</span></h2>
    <p>{tr("Trabajo como desarrollador independiente: diseño la experiencia, implemento la solución y preparo el entorno para que funcione.","I work independently, designing the experience, building the software, and preparing the environment for production.")}</p>
  </div>
  <div class="portfolio-capabilities-grid">
    {capabilities.map((item) => (
      <article class="portfolio-capability">
        <div class="portfolio-capability-top"><span class="mono">{item.index}</span><span class="portfolio-capability-glyph" aria-hidden="true">↗</span></div>
        <p class="portfolio-capability-label">{item.label}</p>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <span class="portfolio-capability-tools">{item.tools}</span>
      </article>
    ))}
  </div>
</section>
