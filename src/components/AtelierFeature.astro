---
import { asset, projectUrl } from "../data/projects";
interface Props { compact?: boolean; lang?: "es" | "en" }
const { compact = false, lang = "es" } = Astro.props;
const tr = (es: string, english: string) => lang === "en" ? english : es;
const shots = [
  {
    file: "atelier-colors.webp",
    label: tr("Color y material", "Color and material"),
    alt: "Atelier de CPAUL: prenda tridimensional y controles de color por zona.",
  },
  {
    file: "atelier-design.webp",
    label: tr("Diseño y bordado", "Design and embroidery"),
    alt: "Atelier de CPAUL: incorporación de un texto de demostración sobre la prenda 3D.",
  },
  {
    file: "atelier-placement.webp",
    label: tr("Ubicación y detalle", "Placement and detail"),
    alt: "Atelier de CPAUL: vista lateral y ubicaciones de personalización.",
  },
];
---

<section
  id="atelier"
  class:list={["atelier-section", "shell", { "is-compact": compact }]}
  aria-labelledby="atelier-title"
>
  <div class="exhibition-heading" data-reveal>
    <p class="eyebrow">01 / ATELIER 3D · CPAUL</p>
    <h2 id="atelier-title">
      {tr("De una idea","From an idea")}
      <br />a una <span class="accent">{tr("prenda.","garment.")}</span>
    </h2>
    <p>
      {tr("Un configurador que convierte color, material y diseño en una experiencia","A configurator that turns color, material and design into an")}
      {tr("tridimensional. Una de las piezas más profundas de mi trabajo.","immersive 3D experience. One of my most detailed projects.")}
    </p>
  </div>
  <div class="atelier-stage" data-reveal>
    <div class="atelier-toolbar">
      <span>CPAUL / PRODUCT DESIGN EXPERIENCE</span>
      <span>{tr("WEB · 3D · PERSONALIZACIÓN","WEB · 3D · CUSTOMIZATION")}</span>
    </div>
    <img
      id="atelier-shot"
      src={asset(`media/${shots[0].file}`)}
      alt={shots[0].alt}
      width="1600"
      height="1000"
      loading="lazy"
    />
  </div>
  <div
    class="atelier-tabs"
    role="group"
    aria-label={tr("Pantallas del Atelier", "Atelier screens")}
    hidden
  >
    {shots.map((shot, i) => (
      <button
        type="button"
        data-atelier-shot={asset(`media/${shot.file}`)}
        data-shot-alt={shot.alt}
        aria-pressed={i === 0}
        aria-controls="atelier-shot"
      >
        0{i + 1} / {shot.label}
      </button>
    ))}
  </div>
  <div class="atelier-description">
    <p>
      {tr("Capturas reales del Atelier ejecutado localmente con un catálogo de","Real screenshots of the Atelier running locally with a demo catalog.")}
      {tr("demostración. El editor combina prendas, colores por zona, materiales,","The editor combines clothing, per-zone colors, materials,")}
      {tr("texto e imágenes, ubicaciones y una vista previa del diseño.","text, images, placement controls and design previews.")}
    </p>
    <div>
      <a
        class="inline-link"
        href={compact ? "#explorar-3d" : projectUrl("cpaul", lang)}
      >
        {tr("Explorá el trabajo detrás del Atelier","Explore the work behind the Atelier")} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <div class="atelier-detail-row">
    <article data-reveal>
      <span class="eyebrow">{tr("01 / CONFIGURAR","01 / CONFIGURE")}</span>
      <h3>{tr("La prenda como punto de partida.","Start with the garment.")}</h3>
      <p>
        {tr("Catálogo de bases, selección de materiales y color por zonas del modelo.","Base garment catalog, material selection and per-zone colors.")}
      </p>
    </article>
    <article data-reveal>
      <span class="eyebrow">{tr("02 / PERSONALIZAR","02 / CUSTOMIZE")}</span>
      <h3>{tr("Un diseño con intención.","Purposeful customization.")}</h3>
      <p>
        {tr("Texto, imágenes y acabados de hilo, con controles de tamaño y ubicación.","Text, graphics and thread finishes with size and placement controls.")}
      </p>
    </article>
    <article data-reveal>
      <span class="eyebrow">{tr("03 / CONECTAR","03 / CONNECT")}</span>
      <h3>{tr("Del editor al pedido.","From editor to order.")}</h3>
      <p>
        {tr("Borrador local, revisión del diseño y preparación de la solicitud de","Local drafts, design review and preparation for a")}
        {tr("cotización.","quotation request.")}
      </p>
    </article>
  </div>
  <div
    id="explorar-3d"
    class="viewer-section"
    data-model-viewer
    data-model={asset("models/atelier-tshirt/model.gltf")}
  >
    <p class="eyebrow">{tr("UNA MUESTRA INTERACTIVA / MODELO DEL PROYECTO","INTERACTIVE PREVIEW / PROJECT MODEL")}</p>
    <h3 style="margin: 16px 0 24px">{tr("Probá el volumen. Cambiá el color.","Explore the volume. Change the color.")}</h3>
    <div class="viewer-shell">
      <img
        class="viewer-poster"
        src={asset("media/atelier-colors.webp")}
        alt="Vista estática del configurador de indumentaria."
        width="1600"
        height="1000"
        loading="lazy"
      />
      <div class="viewer-stage" hidden></div>
      <div class="viewer-start" hidden>
        <button class="solid-button" type="button" data-load-model>
          {tr("Activar muestra 3D","Activate 3D preview")}
        </button>
        <p>
          {tr("Se carga solo al activarla. Podés girar la prenda y explorar sus","Loads only when requested. Rotate the garment and explore its")}
          {tr("colores; el editor completo se muestra en las capturas.","colors; the full editor is shown in the screenshots.")}
        </p>
      </div>
    </div>
    <p class="viewer-status" role="status" aria-live="polite">
      {tr("La imagen estática está disponible sin activar la muestra 3D.","The static image is available without loading the 3D preview.")}
    </p>
    <div class="viewer-controls" hidden>
      <button type="button" data-model-color="#a74c36" aria-pressed="false">
        {tr("Arcilla","Clay")}
      </button>
      <button type="button" data-model-color="#d8d0b8" aria-pressed="false">
        {tr("Lino","Linen")}
      </button>
      <button type="button" data-model-color="#51664a" aria-pressed="false">
        {tr("Oliva","Olive")}
      </button>
      <button type="button" data-model-color="#29363c" aria-pressed="false">
        {tr("Carbón","Charcoal")}
      </button>
      <button
        type="button"
        data-model-turn="-1"
        aria-label="Girar prenda a la izquierda"
      >
        ←
      </button>
      <button
        type="button"
        data-model-turn="1"
        aria-label="Girar prenda a la derecha"
      >
        →
      </button>
      <button type="button" data-model-zoom="0.85" aria-label="Acercar prenda">
        +
      </button>
      <button type="button" data-model-zoom="1.15" aria-label="Alejar prenda">
        −
      </button>
      <button type="button" data-close-model>
        {tr("Cerrar 3D","Close 3D")}
      </button>
    </div>
  </div>
</section>
<script>
  import "../scripts/atelier";
</script>
