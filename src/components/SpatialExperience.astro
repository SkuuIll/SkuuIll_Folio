---
import ArchitectureExplorer from "./ArchitectureExplorer.astro";
import DepthShowcase from "./DepthShowcase.astro";
interface Props { lang?: "es" | "en" }
const lang = Astro.props.lang ?? "es";
const tr = (es: string, english: string) => lang === "en" ? english : es;
import "../styles/spatial.css";
---

<ArchitectureExplorer lang={lang} />
<DepthShowcase lang={lang} />

<section class="portal-journey" id="recorrido" aria-labelledby="journey-title">
  <div class="journey-stage" data-spatial="journey">
    <div class="journey-fallback" aria-hidden="true">
      {Array.from({ length: 9 }, (_, i) => (
        <span style={`--ring:${i}`} />
      ))}
    </div>
    <canvas aria-hidden="true" data-running="false"></canvas>
    <div class="journey-vignette" aria-hidden="true"></div>
    <div class="journey-header shell">
      <span class="mono">SKULL / UMBRAL</span>
      <a href="#laboratorio">
        {tr("Ir al laboratorio","Go to the lab")} <span aria-hidden="true">↘</span>
      </a>
    </div>
    <div class="journey-copy shell">
      <p class="eyebrow">{tr("Un recorrido, tu ritmo","A journey at your pace")}</p>
      <h2 id="journey-title">
        {tr("No mires","Don't just look")}
        <br />
        {tr("desde afuera.","from the outside.")}
      </h2>
      <p class="journey-intro">
        {tr("El scroll es la cámara.","Scrolling becomes the camera.")}
        <br />
        {tr("Seguí bajando para entrar.","Scroll down to enter.")}
      </p>
    </div>
    <div class="journey-chapter shell" aria-hidden="true">
      <span class="mono" data-journey-label>
        {tr("01 / ENTRAR","01 / ENTER")}
      </span>
      <p data-journey-line>{tr("Todo empieza con un gesto.","Everything begins with a gesture.")}</p>
    </div>
    <div class="journey-track shell" aria-hidden="true">
      <span></span>
    </div>
    <p class="journey-accessible">
      {tr("Recorré un túnel de portales geométricos: las formas se abren, la cámara","Explore a tunnel of geometric portals: shapes open and the camera")}
      {tr("avanza y el color acompaña el recorrido. Una escena 3D creada con código.","moves forward as color guides the journey. A 3D scene built with code.")}
    </p>
  </div>
</section>
<script>
  import "../scripts/spatial";
</script>
