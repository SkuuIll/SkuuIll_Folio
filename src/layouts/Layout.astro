---
import "@fontsource-variable/manrope";
import "@fontsource-variable/geist-mono";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import geistLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";
import "../styles/experience.css";

import "../styles/shell.css";
import "../styles/landing.css";
import "../styles/showcase.css";
import "../styles/design-modes.css";
import { asset } from "../data/projects";
import { profile } from "../data/profile";
interface Props {
  title?: string;
  description?: string;
  lang?: "es" | "en";
}
const {
  title = "Skull — Diseño, código e interacción",
  description = profile.summary,
  lang = "es",
} = Astro.props;
const en = lang === "en";
const tr = (es: string, english: string) => en ? english : es;
const home = en ? "en/" : "";
const archive = en ? "en/projects/" : "proyectos/";
const basePath = import.meta.env.BASE_URL;
const relative = Astro.url.pathname.startsWith(basePath) ? Astro.url.pathname.slice(basePath.length) : "";
const spanish = relative.startsWith("en/projects/") ? relative.replace(/^en\/projects\//, "proyectos/") : relative.replace(/^en\//, "");
const english = relative.startsWith("en/") ? relative : relative.startsWith("proyectos/") ? relative.replace(/^proyectos\//, "en/projects/") : "en/" + relative;
const spanishUrl = new URL(basePath + spanish, Astro.site ?? "https://skuull.pages.dev");
const englishUrl = new URL(basePath + english, Astro.site ?? "https://skuull.pages.dev");
const siteOrigin = Astro.site ?? new URL("https://skuull.pages.dev");
const canonical = new URL(Astro.url.pathname, siteOrigin);
const socialImage = new URL(asset("media/social-cover.png"), siteOrigin);
const person = {
  "@type": "Person", "@id": siteOrigin.href + "#person", name: "Skull", alternateName: "SkuuIll",
  jobTitle: "Desarrollador de software independiente", url: siteOrigin.href,
  description: profile.summary, sameAs: [profile.github],
  knowsAbout: ["Desarrollo web", "Android", "Backend", "Automatización"],
  homeLocation: { "@type": "Place", name: "Chaco, Argentina" },
};
const structuredData = { "@context": "https://schema.org", "@graph": [
  person,
  { "@type": "WebSite", "@id": siteOrigin.href + "#website", name: "Skull — Digital Lab", url: siteOrigin.href, inLanguage: en ? "en" : "es-AR", creator: { "@id": person["@id"] } },
  { "@type": "WebPage", "@id": canonical.href + "#webpage", url: canonical.href, name: title, description, inLanguage: en ? "en" : "es-AR",
    isPartOf: { "@id": siteOrigin.href + "#website" }, about: { "@id": person["@id"] }, primaryImageOfPage: socialImage.href },
] };
---

<!doctype html>
<html lang={en ? "en" : "es-AR"} data-material="glass">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Skull (SkuuIll)" />
    <meta name="theme-color" content="#080d13" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-AR" href={spanishUrl.href} />
    <link rel="alternate" hreflang="en" href={englishUrl.href} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl.href} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={asset("favicon-32.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset("apple-touch-icon.png")} />
    <link rel="manifest" href={asset("site.webmanifest")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skull — Digital Lab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={en ? "en_US" : "es_AR"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:secure_url" content={socialImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Skull. — Diseño, código e interacción." />
        <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content="Skull — portafolio de desarrollo de software" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      let theme = "dark";
      try {
        const savedTheme = localStorage.getItem("skull-theme");
        if (["light", "dark"].includes(savedTheme)) theme = savedTheme;
      } catch {}
      document.documentElement.dataset.theme = theme;
      // Cycle through seven art directions on every full page load.
      // A shared key works across Spanish, English and project pages.
      const designs = ["editorial", "casebook", "systems", "atelier", "chromatic", "pocket", "studio"];
      let priorDesign;
      try { priorDesign = sessionStorage.getItem("skull-design-last") || localStorage.getItem("skull-design-last"); } catch {}
      const previousIndex = designs.indexOf(priorDesign);
      const design = designs[(previousIndex + 1) % designs.length];
      document.documentElement.dataset.design = design;
      try { sessionStorage.setItem("skull-design-last", design); } catch {}
      try { localStorage.setItem("skull-design-last", design); } catch {}
      try {
        const material = localStorage.getItem("skull-material");
        document.documentElement.dataset.material = [
          "glass",
          "solid",
          "auto",
        ].includes(material)
          ? material
          : "glass";
      } catch {}

      try {
        // The portfolio now always starts with its complete visual experience.
        sessionStorage.removeItem("skull-motion");
        localStorage.removeItem("skull-motion-mode");
        localStorage.removeItem("spulp-motion-mode");
      } catch {}
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const connection = navigator.connection;
      const limited = Boolean(connection?.saveData || (navigator.deviceMemory !== undefined && navigator.deviceMemory <= 2) || (navigator.hardwareConcurrency !== undefined && navigator.hardwareConcurrency <= 2 && matchMedia("(pointer: coarse)").matches));
      document.documentElement.dataset.performance = limited ? "lite" : matchMedia("(pointer: coarse)").matches ? "balanced" : "full";
      document.documentElement.dataset.motionMode = reducedMotion ? "reduced" : "full";
      document.documentElement.dataset.effects = reducedMotion || limited ? "off" : "full";
      document.documentElement.dataset.motion = reducedMotion || limited ? "paused" : "active";
      const palettes = ["forest", "blue", "clay", "violet", "amber", "ice", "matrix", "neon", "sunset", "cobalt", "rose", "copper"];
      const scenes = ["orb", "ribbon", "helix", "torus", "lattice"];
      let lastPalette, lastScene;
      try {
        lastPalette = sessionStorage.getItem("skull-palette");
        lastScene = sessionStorage.getItem("skull-scene");
      } catch {}
      try {
        lastPalette ||= localStorage.getItem("skull-last-palette");
        lastScene ||= localStorage.getItem("skull-last-scene");
      } catch {}
      const choose = (values, last) => {
        const choices = values.filter((value) => value !== last);
        return choices[Math.floor(Math.random() * choices.length)];
      };
      const designPalettes = { editorial: "matrix", casebook: "copper", systems: "ice", atelier: "violet", chromatic: "neon", pocket: "forest", studio: "amber" };
      const palette = designPalettes[design] || choose(palettes, lastPalette);
      const scene = choose(scenes, lastScene);
      const seed = Math.floor(Math.random() * 1000000);
      document.documentElement.dataset.palette = palette;
      document.documentElement.dataset.scene = scene;
      document.documentElement.dataset.seed = String(seed);
      try {
        sessionStorage.setItem("skull-palette", palette);
        sessionStorage.setItem("skull-scene", scene);
      } catch {}
      try {
        localStorage.setItem("skull-last-palette", palette);
        localStorage.setItem("skull-last-scene", scene);
      } catch {}
    </script>
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">
      {tr("Saltar al contenido", "Skip to content")}
    </a>
    <header class="site-header shell">
      <a class="brand" href={asset(home)} aria-label={tr("Skull, inicio", "Skull, home")}>
        <svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><rect x="1" y="1" width="62" height="62" rx="13" stroke="currentColor" stroke-opacity=".32"/><path d="M27 18H16L11 28L27 34L22 46H10M36 18V46M54 18L36 33L55 46" stroke="currentColor" stroke-width="5" stroke-linecap="square" stroke-linejoin="miter"/></svg>
        <span>
          Skull<span class="brand-period">.</span>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href={asset(home + "#trabajo")}>{tr("Proyectos", "Projects")}</a>
        <a href={asset(home + "#capacidades")}>{tr("Qué hago", "What I do")}</a>
        <a href={asset(home + "#laboratorio")}>{tr("Laboratorio", "Lab")}</a>
        <a href={asset(archive)}>{tr("Archivo", "Archive")}</a>
      </nav>
      <nav class="language-switch" aria-label={tr("Idioma", "Language")}>
        <a href={spanishUrl.pathname} hreflang="es-AR" lang="es" aria-current={!en ? "page" : undefined}>ES</a>
        <span aria-hidden="true">/</span>
        <a href={englishUrl.pathname} hreflang="en" lang="en" aria-current={en ? "page" : undefined}>EN</a>
      </nav>
      <button
        id="chapters-toggle"
        aria-label="Abrir menú"
        class="chapters-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        hidden
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 8h14M5 16h14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Activar modo oscuro"
        aria-pressed="false"
        hidden
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2" />
        </svg>
        <span>Oscuro</span>
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
        hidden
      >
        <span></span>
        <span></span>
      </button>
      <dialog
        id="mobile-nav"
        class="mobile-nav chapter-menu"
        aria-label={tr("Explorar capítulos", "Browse sections")}
        hidden
      >
        <div class="chapter-menu-content shell">
          <div class="chapter-menu-top mono">
            <span>{tr("SKULL / EXPLORAR", "SKULL / EXPLORE")}</span>
            <button type="button" id="chapters-close">
              {tr("Cerrar menú", "Close menu")} <span aria-hidden="true">×</span>
            </button>
          </div>
          <nav aria-label="Navegación por capítulos">
            <a href={asset(home)}>
              <span>00</span>{tr("Inicio","Home")}
            </a>
            <a href={asset(home + "#secuencia")}>
              <span>01</span>{tr("Experiencia","Experience")}
            </a>
            <a href={asset(home + "#trabajo")}>
              <span>02</span>{tr("Proyectos destacados","Featured projects")}
            </a>
            <a href={asset(home + "#capacidades")}>
              <span>03</span>{tr("Qué hago","What I do")}
            </a>
            <a href={asset(home + "#profundidad")}>
              <span>02</span>{tr("Observatorio","Observatory")}
            </a>
            <a href={asset(home + "#recorrido")}>
              <span>03</span>{tr("Umbral 3D","3D portal")}
            </a>
            <a href={asset(home + "#laboratorio")}>
              <span>04</span>{tr("Laboratorio","Lab")}
            </a>
            <a href={asset(home + "#proceso")}>
              <span>05</span>{tr("Proceso","Process")}
            </a>
            <a href={asset(archive)} aria-label="Archivo de proyectos">
              <span>06</span>{tr("Archivo","Archive")}
            </a>
            <a href={asset(home + "#contacto")}>
              <span>07</span>{tr("Contacto","Contact")}
            </a>
          </nav>
          <p class="mono chapter-menu-bottom">
            {tr("CÓDIGO CON IDENTIDAD. / ARGENTINA", "CODE WITH IDENTITY. / ARGENTINA")}
          </p>
        </div>
      </dialog>
    </header>
    <aside class="design-ribbon shell" data-design-ribbon aria-label={tr("Dirección de diseño actual", "Current design direction")}>
      <div class="design-ribbon-main">
        <span class="design-ribbon-figure" aria-hidden="true"></span>
        <div>
          <div class="design-ribbon-title">
            <span class="design-ribbon-caption">{tr("EDICIÓN VISUAL", "VISUAL EDITION")}</span>
            <strong data-design-name>Editorial / {tr("Identidad", "Identity")}</strong>
          </div>
          <p class="design-ribbon-note" data-design-note role="status" aria-live="polite">
            {tr("Tipografía protagonista y composición editorial.", "Expressive type and editorial composition.")}
          </p>
        </div>
      </div>
      <div class="design-ribbon-controls">
        <button type="button" data-design-prev aria-label={tr("Diseño anterior", "Previous design")} title={tr("Diseño anterior", "Previous design")}>
          <span aria-hidden="true">←</span>
        </button>
        <span data-design-index class="design-index" aria-label={tr("Diseño de siete", "Design of seven")}>01 / 07</span>
        <button type="button" data-design-next class="design-next">
          {tr("Otro diseño", "Next design")} <span aria-hidden="true">→</span>
        </button>
      </div>
    </aside>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer shell">
      <a class="footer-name" href={asset(home)}>
        Skull<span>↗</span>
      </a>
      <div>
        <p>{tr("Software desde Chaco, Argentina.", "Software from Chaco, Argentina.")}</p>
        <p class="mono">© {new Date().getUTCFullYear()} / SkuuIll</p>
      </div>
      <div class="footer-links">
        <a href={profile.github}>GitHub ↗</a>
        <button type="button" class="footer-share" id="share-portfolio" hidden>{tr("Compartir ↗", "Share ↗")}</button>
        <a href={`mailto:${profile.email}`}>Email ↗</a>
      </div>
      <p id="share-status" class="share-status mono" role="status" aria-live="polite"></p>
    </footer>
    <script>
      import "../scripts/site";
      import "../scripts/design-modes";
    </script>
  </body>
</html>
