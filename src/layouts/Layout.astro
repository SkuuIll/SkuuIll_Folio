---
import "@fontsource-variable/manrope";
import "@fontsource-variable/geist-mono";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import geistLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";
import "../styles/experience.css";

import "../styles/shell.css";
import "../styles/landing.css";
import "../styles/showcase.css";
import { asset } from "../data/projects";
import { profile } from "../data/profile";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Skull — Diseño, código e interacción",
  description = profile.summary,
} = Astro.props;
const siteOrigin = Astro.site ?? new URL("https://skuull.pages.dev");
const canonical = new URL(Astro.url.pathname, siteOrigin);
const socialImage = new URL(asset("media/social-cover.png"), siteOrigin);
const person = {
  "@type": "Person", "@id": siteOrigin.href + "#person", name: "Skull", alternateName: "SkuuIll",
  jobTitle: "Desarrollador de software independiente", url: siteOrigin.href,
  description: profile.summary, sameAs: [profile.github],
  knowsAbout: ["Desarrollo web", "Android", "Backend", "Automatización"],
  homeLocation: { "@type": "Place", name: "Chaco, Argentina" },
};
const structuredData = { "@context": "https://schema.org", "@graph": [
  person,
  { "@type": "WebSite", "@id": siteOrigin.href + "#website", name: "Skull — Digital Lab", url: siteOrigin.href, inLanguage: "es-AR", creator: { "@id": person["@id"] } },
  { "@type": "WebPage", "@id": canonical.href + "#webpage", url: canonical.href, name: title, description, inLanguage: "es-AR",
    isPartOf: { "@id": siteOrigin.href + "#website" }, about: { "@id": person["@id"] }, primaryImageOfPage: socialImage.href },
] };
---

<!doctype html>
<html lang="es-AR" data-material="glass">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Skull (SkuuIll)" />
    <meta name="theme-color" content="#080d13" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="icon" type="image/png" sizes="32x32" href={asset("favicon-32.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset("apple-touch-icon.png")} />
    <link rel="manifest" href={asset("site.webmanifest")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skull — Digital Lab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:secure_url" content={socialImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Skull. — Diseño, código e interacción." />
        <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content="Skull — portafolio de desarrollo de software" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      let theme = "dark";
      try {
        const savedTheme = localStorage.getItem("skull-theme");
        if (["light", "dark"].includes(savedTheme)) theme = savedTheme;
      } catch {}
      document.documentElement.dataset.theme = theme;
      try {
        const material = localStorage.getItem("skull-material");
        document.documentElement.dataset.material = [
          "glass",
          "solid",
          "auto",
        ].includes(material)
          ? material
          : "glass";
      } catch {}

      try {
        // The portfolio now always starts with its complete visual experience.
        sessionStorage.removeItem("skull-motion");
        localStorage.removeItem("skull-motion-mode");
        localStorage.removeItem("spulp-motion-mode");
      } catch {}
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.documentElement.dataset.motionMode = reducedMotion ? "reduced" : "full";
      document.documentElement.dataset.effects = reducedMotion ? "off" : "full";
      document.documentElement.dataset.motion = reducedMotion ? "paused" : "active";
      const palettes = ["forest", "blue", "clay", "violet", "amber", "ice", "matrix", "neon", "sunset", "cobalt", "rose", "copper"];
      const scenes = ["orb", "ribbon", "helix", "torus", "lattice"];
      let lastPalette, lastScene;
      try {
        lastPalette = sessionStorage.getItem("skull-palette");
        lastScene = sessionStorage.getItem("skull-scene");
      } catch {}
      try {
        lastPalette ||= localStorage.getItem("skull-last-palette");
        lastScene ||= localStorage.getItem("skull-last-scene");
      } catch {}
      const choose = (values, last) => {
        const choices = values.filter((value) => value !== last);
        return choices[Math.floor(Math.random() * choices.length)];
      };
      const palette = choose(palettes, lastPalette);
      const scene = choose(scenes, lastScene);
      const seed = Math.floor(Math.random() * 1000000);
      document.documentElement.dataset.palette = palette;
      document.documentElement.dataset.scene = scene;
      document.documentElement.dataset.seed = String(seed);
      try {
        sessionStorage.setItem("skull-palette", palette);
        sessionStorage.setItem("skull-scene", scene);
      } catch {}
      try {
        localStorage.setItem("skull-last-palette", palette);
        localStorage.setItem("skull-last-scene", scene);
      } catch {}
    </script>
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-header shell">
      <a class="brand" href={asset("")} aria-label="Skull, inicio">
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path
            d="M24 6H11L5 13l21 6-6 7H7"
            stroke="currentColor"
            stroke-width="4"
            stroke-linecap="square"
          />
          <path d="M20 2v8M16 6h8" stroke="currentColor" stroke-width="2" />
        </svg>
        <span>
          Skull<span class="brand-period">.</span>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href={asset("#trabajo")}>Proyectos</a>
        <a href={asset("#capacidades")}>Qué hago</a>
        <a href={asset("#laboratorio")}>Laboratorio</a>
        <a href={asset("proyectos/")}>Archivo</a>
      </nav>
      <button
        id="chapters-toggle"
        aria-label="Abrir menú"
        class="chapters-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        hidden
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 8h14M5 16h14"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Activar modo oscuro"
        aria-pressed="false"
        hidden
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2" />
        </svg>
        <span>Oscuro</span>
      </button>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
        hidden
      >
        <span></span>
        <span></span>
      </button>
      <dialog
        id="mobile-nav"
        class="mobile-nav chapter-menu"
        aria-label="Explorar capítulos"
        hidden
      >
        <div class="chapter-menu-content shell">
          <div class="chapter-menu-top mono">
            <span>SKULL / EXPLORAR</span>
            <button type="button" id="chapters-close">
              Cerrar menú <span aria-hidden="true">×</span>
            </button>
          </div>
          <nav aria-label="Navegación por capítulos">
            <a href={asset("")}>
              <span>00</span>Inicio
            </a>
            <a href={asset("#secuencia")}>
              <span>01</span>Experiencia
            </a>
            <a href={asset("#trabajo")}>
              <span>02</span>Proyectos destacados
            </a>
            <a href={asset("#capacidades")}>
              <span>03</span>Qué hago
            </a>
            <a href={asset("#profundidad")}>
              <span>02</span>Observatorio
            </a>
            <a href={asset("#recorrido")}>
              <span>03</span>Umbral 3D
            </a>
            <a href={asset("#laboratorio")}>
              <span>04</span>Laboratorio
            </a>
            <a href={asset("#proceso")}>
              <span>05</span>Proceso
            </a>
            <a href={asset("proyectos/")} aria-label="Archivo de proyectos">
              <span>06</span>Archivo
            </a>
            <a href={asset("#contacto")}>
              <span>07</span>Contacto
            </a>
          </nav>
          <p class="mono chapter-menu-bottom">
            CÓDIGO CON IDENTIDAD. / ARGENTINA
          </p>
        </div>
      </dialog>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer shell">
      <a class="footer-name" href={asset("")}>
        Skull<span>↗</span>
      </a>
      <div>
        <p>Software desde Chaco, Argentina.</p>
        <p class="mono">© {new Date().getUTCFullYear()} / SkuuIll</p>
      </div>
      <div class="footer-links">
        <a href={profile.github}>GitHub ↗</a>
        <a href={`mailto:${profile.email}`}>Email ↗</a>
      </div>
      <div class="preferences" hidden>
        <label class="material-control">
          Acabado
          <select id="material-mode">
            <option value="glass">Vidrio</option>
            <option value="solid">Sólido</option>
            <option value="auto">Del sistema</option>
          </select>
        </label>

        <button id="palette-toggle" type="button">
          Color: <span>Menta</span>
        </button>
      </div>
    </footer>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
